{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thunderboard",
  "version": "0.1.0",
  "identifier": "com.davidmg.thunderboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thunderboard",
        "width": 560,
        "height": 660,
        "minWidth": 460,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
